#!/usr/bin/env sh
#
# ask the user to confirm if they want to continue
# arguments passed will be the query question
#

if command -v "gum" > /dev/null 2>&1; then
  gum confirm
  exit
fi

[ -n "$*" ] && QUERY="$*"" (y/n)" || QUERY="Continue? (y/n)"

until [ "$INPUT" = "y" ]; do
  printf "%s " "$QUERY"
  read -r INPUT

  case $INPUT in
          y)
          exit "0"
          ;;
          n)
          exit "1"
          ;;
          *)
          ;;
  esac
done
